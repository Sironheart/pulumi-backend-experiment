{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "GoReleaser Ko base image digest",
      "managerFilePatterns": ["/\\.goreleaser\\.ya?ml$/"],
      "matchStrings": [
        "base_image:\\s*(?<depName>cgr\\.dev/chainguard/static):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
